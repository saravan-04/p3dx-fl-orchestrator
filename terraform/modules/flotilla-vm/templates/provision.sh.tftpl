#!/bin/bash
# Rendered by terraform/modules/flotilla-vm (null_resource.provision_flotilla)
# and uploaded/run on the VM itself. Installs Docker, builds the Flotilla
# image for this VM's role, generates the demo CIFAR10 dataset partition
# (config/flotilla_quicksetup_config.yaml expects models/FedAT_CNN +
# dataset CIFAR10_IID, generated by generate_dataset.py — no real dataset
# ships with the repo), and starts the container.
set -euo pipefail

echo "STAGE: Installing Docker"
if ! command -v docker >/dev/null 2>&1; then
  curl -fsSL https://get.docker.com | sudo sh
fi
sudo systemctl enable --now docker

cd "${flotilla_dir}"

%{ if role == "server" ~}
echo "STAGE: Building flotilla-server and flotilla-session images"
sudo docker build -f deployment/Dockerfile.server -t flotilla-server:${image_tag} .
sudo docker build -f deployment/Dockerfile.session -t flotilla-session:latest .

echo "STAGE: Generating validation dataset partition"
mkdir -p src/val_data src/data
sudo docker run --rm \
  -v "$(pwd)/src/val_data:/valdata" \
  -v "$(pwd)/src/data:/data" \
  -v "$(pwd)/generate_dataset.py:/generate_dataset.py:ro" \
  flotilla-server:${image_tag} python /generate_dataset.py

echo "STAGE: Starting flotilla-server stack (server + redis + mosquitto)"
mkdir -p deployment/checkpoints deployment/server_logs
cd deployment
sudo DISCOVERY_TYPE=${discovery_type} IMAGE_TAG=${image_tag} \
  docker compose -f docker-compose.yaml up -d
echo "STAGE: flotilla-server started"

%{ else ~}
echo "STAGE: Building flotilla-client image"
sudo docker build -f deployment/Dockerfile.client -t flotilla-client:${image_tag} .

echo "STAGE: Generating client dataset partition"
mkdir -p src/data src/val_data
sudo docker run --rm \
  -v "$(pwd)/src/data:/data" \
  -v "$(pwd)/src/val_data:/valdata" \
  -v "$(pwd)/generate_dataset.py:/generate_dataset.py:ro" \
  flotilla-client:${image_tag} python /generate_dataset.py

echo "STAGE: Starting flotilla-client (server=${server_host})"
sudo docker rm -f flotilla-client >/dev/null 2>&1 || true
sudo docker run -d --name flotilla-client --network host --restart unless-stopped \
  -e CLIENT_NAME=${participant_name} \
  -e CLIENT_ADVERTISE_HOST=${client_advertise_host} \
  -e SERVER_GRPC_HOST=${server_host} \
  -e DISCOVERY_TYPE=${discovery_type} \
  -e MONITOR=${monitor} \
  -e DATASETS_DIR_PATH=/data \
  -v "$(pwd)/src/data:/data" \
  flotilla-client:${image_tag}
echo "STAGE: flotilla-client started"
%{ endif ~}
